# --- dreamdex-perps-mcp -------------------------------------------------
# Copy to .env and fill in. NEVER commit a real key.

# Signer key for the testnet wallet (omit entirely for a read-only server).
# Use a throwaway testnet key — this wallet trades on the Somnia Hideki
# testnet with paper USDso only.
PRIVATE_KEY=

# Master safety switch. Write tools refuse to run unless this is "true".
TRADING_ENABLED=false

# Hard cap on a single order's notional value, in USD.
MAX_ORDER_NOTIONAL_USD=50

# Slippage tolerance for market (IOC) orders, in basis points (100 = 1%).
SLIPPAGE_BPS=100

# Indexer GraphQL endpoint (Hideki testnet default shown).
# INDEXER_URL=https://hideki-dev.smk.somnia.host/v1/graphql
